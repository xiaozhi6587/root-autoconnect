<local:MacWindow x:Class="UsbAutoConnect.ExclusionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UsbAutoConnect"
        Title="排除设备管理" Width="760" Height="330" MinWidth="640" MinHeight="260" WindowStartupLocation="CenterOwner" Background="{DynamicResource ToneF5F5F7}" Foreground="{DynamicResource Tone242426}" FontFamily="Microsoft YaHei UI" FontSize="12">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="排除设备管理" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="选中设备可恢复自动连接；已建立的连接保留。" TextWrapping="Wrap" Foreground="{DynamicResource Tone6E6E73}" Margin="0,5,0,10"/>
    <Grid Grid.Row="2">
      <DataGrid x:Name="RulesGrid" RowHeight="28" ColumnHeaderHeight="28" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="{DynamicResource ToneFFFFFF}" RowBackground="{DynamicResource ToneFFFFFF}" AlternatingRowBackground="{DynamicResource ToneF7F8FA}" Foreground="{DynamicResource Tone242426}" SelectionChanged="RulesGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="*" MinWidth="150"/>
          <DataGridTextColumn Header="远程主机" Binding="{Binding Server}" Width="125"/>
          <DataGridTextColumn Header="VID:PID" Binding="{Binding Hardware}" Width="85"/>
          <DataGridTextColumn Header="匹配依据" Binding="{Binding Identifier}" Width="190"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="NoRulesText" Text="暂无排除设备，可在主窗口右键设备添加。" Foreground="{DynamicResource Tone777780}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <Button Content="关闭" DockPanel.Dock="Right" Click="Close_Click" Margin="10,0,0,0"/>
      <Button x:Name="RestoreButton" Content="恢复选中设备的自动连接" Style="{StaticResource AccentButton}" IsEnabled="False" DockPanel.Dock="Right" Click="Restore_Click"/>
      <TextBlock x:Name="CountText" Foreground="{DynamicResource Tone6E6E73}" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</local:MacWindow>


